#pragma once

// Copy this file to secrets.h (in the same include/ directory) and fill in
// your real WiFi credentials. secrets.h is gitignored so real credentials
// never get committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// No API token needed here anymore -- the firmware authenticates using its
// own WiFi MAC address (set automatically in setup()). Register this device
// to a patient once with:
//   python manage.py register_device <MAC address, printed to Serial at boot> <patient_id>
