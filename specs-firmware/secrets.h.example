#pragma once

// Copy this file to secrets.h (in the same include/ directory) and fill in
// your real WiFi credentials and API token. secrets.h is gitignored so real credentials
// never get committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Signed patient session token from POST /api/recognition/issue-patient-session-token/
// (or from identify-patient/), sent as "Authorization: Bearer <token>".
#define PATIENT_SESSION_TOKEN "your-patient-session-token"
